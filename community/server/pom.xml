  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze</id>
            <goals>
              <goal>analyze-only</goal>
            </goals>
            <configuration>
              <failOnWarning>true</failOnWarning>
              <ignoredUnusedDeclaredDependencies>
                <!-- Required by Jersey/JAXB integration; no direct bytecode imports -->
                <ignoredUnusedDeclaredDependency>jakarta.xml.bind:jakarta.xml.bind-api</ignoredUnusedDeclaredDependency>
                <!-- Registers ALPN server processor via META-INF/services/org.eclipse.jetty.io.ssl.ALPNProcessor$Server -->
                <ignoredUnusedDeclaredDependency>org.eclipse.jetty:jetty-alpn-java-server</ignoredUnusedDeclaredDependency>
                <!-- JAXB implementation discovered at runtime via META-INF/services/javax.xml.bind.JAXBContext -->
                <ignoredUnusedDeclaredDependency>org.glassfish.jaxb:jaxb-runtime</ignoredUnusedDeclaredDependency>
                <!-- Registers ServletContainerInitializer via META-INF/services; no direct bytecode imports -->
                <ignoredUnusedDeclaredDependency>org.glassfish.jersey.containers:jersey-container-servlet</ignoredUnusedDeclaredDependency>
                <!-- Registers InjectionManagerFactory via META-INF/services/org.glassfish.jersey.internal.inject.InjectionManagerFactory -->
                <ignoredUnusedDeclaredDependency>org.glassfish.jersey.inject:jersey-hk2</ignoredUnusedDeclaredDependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
